# The frontend talks to the API through the Vite dev proxy (/api -> 127.0.0.1:8000),
# so no API URL is required for local development.
#
# For a production build where the SPA is served from a different origin than the
# API, set the API base URL here and read it via import.meta.env in src/lib/api.ts.
# VITE_API_BASE_URL=https://api.example.com
